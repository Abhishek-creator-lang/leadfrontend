# Copy to .env.local and fill in. Next.js and the db:* scripts both load it.

# PostgreSQL 13+ (gen_random_uuid() is built in)
# On Vercel + Neon: DATABASE_URL = the *pooled* connection string ("-pooler" in the host),
# DATABASE_URL_UNPOOLED = the direct one (used by db:migrate and content:import/export).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lead_frontend
DATABASE_URL_UNPOOLED=
# Optional: connections per server instance (default 10 locally, 3 on Vercel)
DB_POOL_MAX=

# Public base URL, used to build links in emails
APP_URL=http://localhost:3100

# SMTP. Leave SMTP_HOST empty in development to print emails (and their links) to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lead Frontend <no-reply@example.com>"

# The single super admin, created by the seed_super_admin migration (npm run db:migrate)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=change-me-please
